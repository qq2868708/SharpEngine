<Project>
  <PropertyGroup><SharpEngineRole>Editor</SharpEngineRole></PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <SharpEngineModuleId>SharpEngine.Timeline.Editor</SharpEngineModuleId>
    <SharpEngineModuleType>Editor</SharpEngineModuleType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SharpEngine.Timeline.Editor</AssemblyName>
    <RootNamespace>SharpEngine.Timeline</RootNamespace>
    <Version>0.2.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>$(SharpEngineBinariesDir)</OutputPath>
    <BaseIntermediateOutputPath>$(SharpEngineIntermediateDir)SharpEngine.Timeline.Editor\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpEngine.Timeline.Runtime\SharpEngine.Timeline.Runtime.csproj" />
    <ProjectReference Include="..\SharpEngine.Editor\SharpEngine.Editor.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>

<Project>
  <PropertyGroup><SharpEngineRole>Runtime</SharpEngineRole></PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SharpEngine.Runtime</AssemblyName>
    <RootNamespace>SharpEngine.Runtime</RootNamespace>
    <Version>0.2.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(SharpEngineBinariesDir)</OutputPath>
    <BaseIntermediateOutputPath>$(SharpEngineIntermediateDir)SharpEngine.Runtime\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpEngine.ComponentGenerator\SharpEngine.ComponentGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>

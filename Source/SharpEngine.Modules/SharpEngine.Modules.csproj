<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SharpEngine.Modules</AssemblyName>
    <RootNamespace>SharpEngine.Modules</RootNamespace>
    <Version>0.2.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>$(SharpEngineBinariesDir)</OutputPath>
    <BaseIntermediateOutputPath>$(SharpEngineIntermediateDir)SharpEngine.Modules\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpEngine.ComponentGenerator\SharpEngine.ComponentGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

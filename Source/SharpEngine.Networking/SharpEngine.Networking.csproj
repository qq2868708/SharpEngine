<Project>
  <PropertyGroup>
    <SharpEngineRole>Runtime</SharpEngineRole>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <SharpEngineModuleId>SharpEngine.Networking</SharpEngineModuleId>
    <SharpEngineModuleType>Runtime</SharpEngineModuleType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SharpEngine.Networking</AssemblyName>
    <RootNamespace>SharpEngine.Networking</RootNamespace>
    <Version>0.2.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>$(SharpEngineBinariesDir)</OutputPath>
    <BaseIntermediateOutputPath>$(SharpEngineIntermediateDir)SharpEngine.Networking\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
    <ProjectReference Include="..\SharpEngine.Runtime\SharpEngine.Runtime.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>

<Project>
  <PropertyGroup><SharpEngineRole>Host</SharpEngineRole></PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <DefineConstants Condition="'$(SharpEngineTarget)' == 'Editor'">$(DefineConstants);SHARPENGINE_EDITOR</DefineConstants>
    <OutputType>Library</OutputType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>SharpEngine.Host</AssemblyName>
    <RootNamespace>SharpEngine.Host</RootNamespace>
    <Version>0.2.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseAppHost>false</UseAppHost>
    <OutputPath>$(SharpEngineBinariesDir)</OutputPath>
    <BaseIntermediateOutputPath>$(SharpEngineIntermediateDir)SharpEngine.Host\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpEngine.Runtime\SharpEngine.Runtime.csproj" />
    <ProjectReference Include="..\SharpEngine.Timeline.Runtime\SharpEngine.Timeline.Runtime.csproj" Condition="'$(SharpEngineTarget)' != 'Server'" />
    <ProjectReference Include="..\SharpEngine.Editor\SharpEngine.Editor.csproj" Condition="'$(SharpEngineTarget)' == 'Editor'" />
    <ProjectReference Include="..\SharpEngine.Timeline.Editor\SharpEngine.Timeline.Editor.csproj" Condition="'$(SharpEngineTarget)' == 'Editor'" />
    <ProjectReference Include="..\SharpEngine.Animation.Editor\SharpEngine.Animation.Editor.csproj" Condition="'$(SharpEngineTarget)' == 'Editor'" />
    <ProjectReference Include="..\SharpEngine.Networking\SharpEngine.Networking.csproj" Condition="'$(SharpEngineTarget)' == 'Server'" />
  </ItemGroup>
  <ItemGroup Condition="'$(SharpEngineTarget)' == 'Game'">
    <Compile Remove="EditorEntrypoint.cs" />
    <Compile Remove="EditorFirstUse.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SharpEngineTarget)' == 'Server'">
    <Compile Remove="EditorEntrypoint.cs" />
    <Compile Remove="EditorFirstUse.cs" />
    <Compile Remove="GameEntrypoint.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SharpEngineTarget)' != 'Game'">
    <Compile Remove="GameEntrypoint.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SharpEngineTarget)' != 'Server'">
    <Compile Remove="ServerEntrypoint.cs" />
    <Compile Remove="DedicatedServerApplication.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>

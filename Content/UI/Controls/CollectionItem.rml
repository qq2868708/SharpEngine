<template>
  <div id="${Id}" class="se-collection-item">
    <div class="se-collection-item-header"><span class="se-collection-index se-property-name">${Index}</span><div class="se-value-editor se-property-commands"><button id="${Id}-up" class="se-collection-command" data-action="${UpAction}" ui-disabled="UpDisabled" title="Move item up">↑</button><button id="${Id}-down" class="se-collection-command" data-action="${DownAction}" ui-disabled="DownDisabled" title="Move item down">↓</button><button id="${Id}-remove" class="se-collection-command" data-action="${RemoveAction}" ui-disabled="RemoveDisabled" title="Remove item">×</button></div></div>
    <div class="se-collection-value"><ui-slot name="Value" /></div>
  </div>
</template>

<template>
  <div id="${Id}" class="se-struct ${StateClass}">
    <div class="se-property-row"><button id="${Id}-toggle" class="se-struct-toggle se-property-name" data-action="${ToggleAction}" data-value-view="true" aria-expanded="${ExpandedState}" title="${Label}"><img src="${ToggleIcon}" /><span>${Label}</span></button><div class="se-value-editor" /></div>
    <ui-if test="Expanded"><div id="${Id}-members" class="se-struct-members"><ui-slot name="Members" /></div></ui-if>
  </div>
</template>

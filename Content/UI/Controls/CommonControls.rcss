.se-tree-rows { display: block; width: 100%; }
.se-tree-row { position: relative; display: block; width: 100%; height: 40px; }
.se-tree-row:hover { background-color: #2c3a49; }
.se-tree-row.selected { background-color: #285348; }
.se-tree-guide { position: absolute; z-index: 2; top: 0px; bottom: 0px; width: 1px; background-color: #405062; pointer-events: none; }
.se-tree-toggle { position: absolute; z-index: 3; top: 8px; display: block; width: 20px; height: 24px; margin: 0px; padding: 4px 2px; background-color: transparent; border-width: 0px; }
.se-tree-toggle img { width: 16px; height: 16px; pointer-events: none; }
.se-tree-toggle:hover { background-color: #43576d; }
.se-tree-select { position: relative; z-index: 1; display: block; width: 100%; height: 40px; padding: 0px; margin: 0px; background-color: transparent; border-width: 0px; border-radius: 0px; text-align: left; }
.se-tree-icon { position: absolute; top: 11px; width: 18px; height: 18px; pointer-events: none; }
.se-tree-copy { position: absolute; top: 4px; right: 8px; display: block; min-width: 0px; pointer-events: none; }
.se-tree-name { display: block; width: 100%; color: #e3edf7; font-size: 12px; line-height: 17px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.se-tree-detail { display: block; width: 100%; color: #8da5bd; font-size: 9px; line-height: 13px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.se-value-field, .se-property-row { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; width: 100%; min-width: 0px; margin: 0px; border-bottom: 1px #303844; }
.se-property-name { box-sizing: border-box; display: block; flex: 0 0 36%; width: 36%; min-width: 0px; padding: 9px 8px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.se-value-field > label { margin: 0px; color: #8fa2b8; font-size: 11px; line-height: 18px; }
.se-value-editor { box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; flex: 1 1 0px; align-self: stretch; width: 0px; min-width: 0px; padding: 4px 6px; border-left: 1px #384452; }
.se-property-commands { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 4px; }
.se-value-field > .se-value-editor > button { box-sizing: border-box; max-width: 100%; white-space: normal; }
.se-value-hint { display: block; color: #77899e; font-size: 10px; }
.se-value-input { box-sizing: border-box; position: relative; z-index: 1; display: block; width: 100%; min-width: 0px; height: 28px; padding: 5px 6px; margin: 0px; color: #d6deeb; background-color: #191d24; border: 1px #383f4c; border-radius: 3px; font-size: 12px; }
.se-vector { display: flex; flex-direction: row; flex-wrap: nowrap; width: 100%; min-width: 0px; gap: 4px; }
.se-vector-axis { display: flex; flex: 1 1 0px; min-width: 0px; align-items: center; }
.se-vector-axis > label { display: block; flex: 0 0 14px; width: 14px; min-width: 14px; font-size: 10px; }
.se-vector-axis > input { width: 0px; min-width: 0px; flex: 1 1 0px; }
.se-axis-X > label, .se-axis-R > label { color: #df9693; }
.se-axis-Y > label, .se-axis-G > label { color: #96c29f; }
.se-axis-Z > label, .se-axis-B > label { color: #93b8e5; }
.se-axis-W > label, .se-axis-A > label { color: #bca7d4; }
.se-transform { display: block; width: 100%; min-width: 0px; padding: 5px 0px; }
.se-transform-title { color: #d7e2ef; margin: 4px 0px 8px; }
.se-value-input selectvalue { display: block; height: 28px; margin-right: 24px; padding: 5px 6px; background-color: #191d24; border: 1px #383f4c; }
.se-value-input selectarrow { width: 24px; height: 28px; padding: 4px; decorator: image("sharpengine-resource://engine/Resources/Editor/Icons/chevron-down.tga" contain); background-color: #303a48; border: 1px #3f4d60; }
.se-value-input selectbox { width: 100%; max-height: 224px; padding: 4px; background-color: #252e3b; border: 1px #607b9b; }
.se-value-input option { display: block; min-height: 26px; padding: 5px 6px; }
.se-value-input option:checked, .se-value-input option:hover { background-color: #314d6a; }
select.se-value-input { box-sizing: border-box; height: 28px; padding: 0px; text-align: left; }
select.se-value-input selectvalue { box-sizing: border-box; height: 26px; margin: 0px 24px 0px 0px; padding: 5px 6px; line-height: 16px; background-color: transparent; border-width: 0px; white-space: nowrap; text-overflow: ellipsis; }
select.se-value-input selectarrow { box-sizing: border-box; width: 24px; height: 26px; padding: 5px; border-width: 0px; border-left: 1px #3f4d60; }
select.se-value-input selectbox { box-sizing: border-box; margin-top: 3px; }
.se-value-boolean { display: inline-block; width: 16px; min-width: 16px; height: 16px; padding: 0px; margin: 0px; background-color: #1b222c; border: 1px #57667b; border-radius: 3px; }
.se-value-boolean:checked { decorator: image("sharpengine-resource://engine/Resources/Editor/Icons/check.tga" contain); background-color: #3978b5; border-color: #6da6de; }
.se-value-multiline { height: auto; min-height: 80px; }
.se-value-range { display: block; width: 100%; min-width: 0px; height: 18px; margin-top: 4px; }
.se-value-range slidertrack { background-color: #171e27; height: 4px; margin-top: 7px; }
.se-value-range sliderbar { background-color: #69a4df; width: 12px; height: 16px; }
.se-value-range:disabled { opacity: 0.4; cursor: default; focus: none; }
.se-color { flex-wrap: wrap; }
.se-value-input:disabled, .se-value-input:disabled:hover, .se-value-input:disabled:focus { color: #7c8795; background-color: #20252c; border-color: #303740; cursor: default; focus: none; }
.se-value-field-disabled > label { color: #697583; }
.se-value-field-disabled .se-vector-axis > label, .se-vector-axis-disabled > label { color: #697583; }
.se-value-input:disabled selectvalue { color: #7c8795; background-color: #20252c; border-color: #303740; }
.se-value-input:disabled selectarrow { opacity: 0.4; background-color: #20252c; border-color: #303740; }
select.se-value-input:disabled selectvalue { background-color: transparent; border-width: 0px; }
.se-value-boolean:disabled, .se-value-boolean:disabled:hover, .se-value-boolean:disabled:focus { opacity: 0.4; background-color: #20252c; border-color: #303740; cursor: default; focus: none; }
.se-value-editor > .se-value-hint { min-height: 0px; margin-top: 3px; padding: 0px; background-color: transparent; border-width: 0px; }
.se-value-field-disabled .se-value-hint { color: #697583; }

.se-tree-row.reference .se-tree-detail { color: #b4a4e0; }
.color-picker { display: block; width: 100%; min-width: 0px; margin-top: 8px; }
.color-picker-toggle { box-sizing: border-box; display: flex; align-items: center; width: 100%; height: 28px; padding: 4px 7px; background-color: #303b4a; border: 1px #4b5e75; color: #c4d7ee; font-size: 11px; }
.color-picker-toggle:hover { background-color: #3b4b60; }
.color-picker-chip { display: block; width: 28px; height: 16px; margin-right: 8px; border: 1px #8291a6; }
.color-picker-toggle .icon { width: 14px; height: 14px; margin-left: auto; }
.color-picker-panel { box-sizing: border-box; display: none; width: 100%; padding: 10px; margin-top: 5px; background-color: #1a2029; border: 1px #485a71; border-radius: 4px; }
.color-picker-panel > label { display: block; font-size: 10px; line-height: 15px; color: #8e9fb6; margin-top: 7px; }
.color-picker-sv { display: block; position: relative; width: 100%; height: 130px; background-color: #ff0000; decorator: image("sharpengine-resource://engine/Resources/Editor/ColorPicker/sv.tga"); cursor: cross; }
.color-picker-marker { position: absolute; width: 8px; height: 8px; margin-left: -5px; margin-top: -5px; border: 2px white; border-radius: 5px; background-color: #00000000; pointer-events: none; }
.color-picker-hue { display: block; position: relative; width: 100%; height: 15px; decorator: image("sharpengine-resource://engine/Resources/Editor/ColorPicker/hue.tga"); cursor: pointer; }
.color-picker-track-marker { position: absolute; width: 3px; height: 17px; top: -1px; margin-left: -2px; border: 1px white; background-color: #1a2029; pointer-events: none; }
.color-picker-preview { box-sizing: border-box; display: block; height: 27px; margin-top: 7px; padding: 5px; font-size: 10px; color: #d5deeb; background-color: #293443; border-left-width: 22px; }
.color-picker-buttons { display: flex; gap: 7px; margin-top: 8px; }
.color-picker-buttons button { box-sizing: border-box; flex: 1; height: 26px; padding: 4px; background-color: #2f3947; border: 1px #4a5a70; color: #bccbdf; font-size: 11px; }
.color-picker-buttons button:hover { border-color: #8cb5e6; }
.color-picker-buttons .color-picker-apply { background-color: #315c87; border-color: #5a8dbf; color: #edf6ff; }
.color-picker-toggle:disabled { color: #7c8795; background-color: #20252c; border-color: #303740; cursor: default; focus: none; }
.color-picker-toggle:disabled .color-picker-chip { opacity: 0.4; }
.color-picker-toggle:disabled .icon { opacity: 0.4; }
.se-collection { display: block; width: 100%; min-width: 0px; margin: 0px; background-color: #1c242e; box-sizing: border-box; }
.se-collection-header { display: flex; align-items: center; padding: 0px; border-bottom: 1px #384658; }
.se-collection-toggle { box-sizing: border-box; display: flex; align-items: center; min-width: 0px; min-height: 36px; gap: 7px; color: #d6deeb; background-color: transparent; border-width: 0px; font-size: 12px; text-align: left; }
.se-collection-toggle > span, .se-struct-toggle > span { min-width: 0px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; pointer-events: none; }
.se-collection-toggle:hover { background-color: #2c3a49; }
.se-collection-toggle > img { width: 14px; height: 14px; pointer-events: none; }
.se-collection-count { margin-right: auto; color: #93a8be; font-size: 11px; }
.se-collection-command { box-sizing: border-box; display: block; width: 28px; height: 26px; padding: 3px; margin: 0px; font-size: 14px; text-align: center; color: #cfdef0; background-color: #303b4a; border: 1px #4b5e75; }
.se-collection-command:hover { background-color: #3b4b60; }
.se-collection-command:disabled, .se-collection-command:disabled:hover { color: #697583; background-color: #20252c; border-color: #303740; cursor: default; focus: none; }
.se-collection-items { display: block; padding: 0px; }
.se-collection-item { display: block; margin: 0px; padding: 0px; }
.se-collection-item-header { display: flex; align-items: center; border-bottom: 1px #344153; }
.se-collection-index { color: #8fa2b8; font-size: 11px; }
.se-collection-value { display: block; min-width: 0px; }
.se-collection-disabled .se-collection-toggle, .se-collection-disabled .se-collection-count, .se-collection-disabled .se-collection-index { color: #697583; }
.se-collection-disabled .se-value-field > label, .se-collection-disabled .se-vector-axis > label { color: #697583; }
.se-map { display: block; width: 100%; min-width: 0px; margin: 0px; background-color: #1c242e; box-sizing: border-box; }
.se-map-header { display: flex; align-items: center; padding: 0px; border-bottom: 1px #384658; }
.se-map-entries { display: block; padding: 0px; }
.se-map-entry { display: block; min-width: 0px; margin: 0px; padding: 0px; }
.se-map-entry-header { display: flex; align-items: center; min-width: 0px; border-bottom: 1px #344153; }
.se-map-key { display: block; flex: 1; min-width: 0px; }
.se-map-key .se-value-field { margin: 0px; }
.se-map-key .se-value-field > label { display: none; }
.se-map-key .se-value-editor { width: 100%; padding: 0px; border-left-width: 0px; }
.se-map-key .se-value-input { width: 100%; }
.se-map-entry-value { display: block; min-width: 0px; }
.se-map-disabled .se-collection-toggle, .se-map-disabled .se-collection-count { color: #697583; }
.se-map-disabled .se-value-field > label, .se-map-disabled .se-vector-axis > label { color: #697583; }
.se-struct { display: block; width: 100%; min-width: 0px; margin: 0px; box-sizing: border-box; }
.se-struct > .se-property-row { background-color: #222d3b; }
.se-struct-toggle { display: flex; min-height: 36px; align-items: center; gap: 6px; background-color: transparent; border: 0px; color: #c8d5e3; text-align: left; }
.se-struct-toggle:hover { background-color: #2b394b; }
.se-struct-toggle img { width: 12px; height: 12px; flex-shrink: 0; pointer-events: none; }
.se-struct-members { display: block; min-width: 0px; padding: 0px; }

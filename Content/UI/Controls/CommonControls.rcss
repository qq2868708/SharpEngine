.se-tree-rows { display: block; width: 100%; }
.se-tree-row { position: relative; display: block; width: 100%; height: 40px; }
.se-tree-row:hover { background-color: #2c3a49; }
.se-tree-row.selected { background-color: #285348; }
.se-tree-guide { position: absolute; z-index: 2; top: 0px; bottom: 0px; width: 1px; background-color: #405062; pointer-events: none; }
.se-tree-toggle { position: absolute; z-index: 3; top: 8px; display: block; width: 20px; height: 24px; margin: 0px; padding: 4px 2px; background-color: transparent; border-width: 0px; }
.se-tree-toggle img { width: 16px; height: 16px; pointer-events: none; }
.se-tree-toggle:hover { background-color: #43576d; }
.se-tree-select { position: relative; z-index: 1; display: block; width: 100%; height: 40px; padding: 0px; margin: 0px; background-color: transparent; border-width: 0px; border-radius: 0px; text-align: left; }
.se-tree-icon { position: absolute; top: 11px; width: 18px; height: 18px; pointer-events: none; }
.se-tree-copy { position: absolute; top: 4px; right: 8px; display: block; min-width: 0px; pointer-events: none; }
.se-tree-name { display: block; width: 100%; color: #e3edf7; font-size: 12px; line-height: 17px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.se-tree-detail { display: block; width: 100%; color: #8da5bd; font-size: 9px; line-height: 13px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.se-value-field { display: block; width: 100%; min-width: 0px; margin-bottom: 8px; }
.se-value-field > label { display: block; margin-bottom: 4px; color: #8fa2b8; font-size: 10px; }
.se-value-hint { display: block; color: #77899e; font-size: 10px; }
.se-value-input { position: relative; z-index: 1; display: block; width: 100%; min-width: 0px; height: 28px; padding: 5px 6px; margin: 0px; color: #d6deeb; background-color: #191d24; border: 1px #383f4c; border-radius: 3px; font-size: 12px; }
.se-vector { display: flex; flex-direction: row; flex-wrap: nowrap; width: 100%; min-width: 0px; gap: 4px; }
.se-vector-axis { display: flex; flex: 1 1 0px; min-width: 0px; align-items: center; }
.se-vector-axis > label { display: block; flex: 0 0 14px; width: 14px; min-width: 14px; font-size: 10px; }
.se-vector-axis > input { width: 0px; min-width: 0px; flex: 1 1 0px; }
.se-axis-X > label, .se-axis-R > label { color: #df9693; }
.se-axis-Y > label, .se-axis-G > label { color: #96c29f; }
.se-axis-Z > label, .se-axis-B > label { color: #93b8e5; }
.se-axis-W > label, .se-axis-A > label { color: #bca7d4; }
.se-transform { display: block; width: 100%; min-width: 0px; padding: 5px 0px; }
.se-transform-title { color: #d7e2ef; margin: 4px 0px 8px; }
.se-value-input selectvalue { display: block; height: 28px; margin-right: 24px; padding: 5px 6px; background-color: #191d24; border: 1px #383f4c; }
.se-value-input selectarrow { width: 24px; height: 28px; padding: 4px; decorator: image("sharpengine-resource://engine/Resources/Editor/Icons/chevron-down.tga" contain); background-color: #303a48; border: 1px #3f4d60; }
.se-value-input selectbox { width: 100%; max-height: 224px; padding: 4px; background-color: #252e3b; border: 1px #607b9b; }
.se-value-input option { display: block; min-height: 26px; padding: 5px 6px; }
.se-value-input option:checked, .se-value-input option:hover { background-color: #314d6a; }
.se-value-boolean { display: inline-block; width: 16px; min-width: 16px; height: 16px; padding: 0px; margin: 0px; background-color: #1b222c; border: 1px #57667b; border-radius: 3px; }
.se-value-boolean:checked { decorator: image("sharpengine-resource://engine/Resources/Editor/Icons/check.tga" contain); background-color: #3978b5; border-color: #6da6de; }
.se-value-multiline { height: auto; min-height: 80px; }
.se-value-input:disabled, .se-value-input:disabled:hover, .se-value-input:disabled:focus { color: #7c8795; background-color: #20252c; border-color: #303740; cursor: default; focus: none; }
.se-value-field-disabled > label { color: #697583; }
.se-value-field-disabled .se-vector-axis > label, .se-vector-axis-disabled > label { color: #697583; }
.se-value-input:disabled selectvalue { color: #7c8795; background-color: #20252c; border-color: #303740; }
.se-value-input:disabled selectarrow { opacity: 0.4; background-color: #20252c; border-color: #303740; }
.se-value-boolean:disabled, .se-value-boolean:disabled:hover, .se-value-boolean:disabled:focus { opacity: 0.4; background-color: #20252c; border-color: #303740; cursor: default; focus: none; }
.se-value-field > .se-value-hint { min-height: 0px; margin-top: 3px; padding: 0px; background-color: transparent; border-width: 0px; }
.se-value-field-disabled > .se-value-hint { color: #697583; }

.se-tree-row.reference .se-tree-detail { color: #b4a4e0; }

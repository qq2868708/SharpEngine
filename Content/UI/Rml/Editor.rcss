div { display: block; }
body { width: 100%; height: 100%; margin: 0; font-family: Segoe UI; font-size: 13px; color: #c6ccd6; background-color: #171a20; }
* { box-sizing: border-box; }
#editor { width: 100%; height: 100%; display: flex; flex-direction: column; }
#menubar { height: 32px; flex-shrink: 0; display: flex; align-items: center; padding: 0px 12px; background-color: #191c22; border-bottom: 1px #101216; }
#topMenus { display: flex; align-items: center; height: 32px; }
.top-menu { position: relative; height: 32px; }
.brand { width: 168px; font-weight: bold; color: #edf1f7; }
.brand-mark { color: #68a9f2; margin-right: 7px; }
button { display: inline-block; background-color: #30353e; color: #d4dae4; border: 1px #424954; border-radius: 3px; padding: 5px 12px; cursor: pointer; font-family: Segoe UI; font-size: 12px; text-align: center; }
button:hover { background-color: #414a58; border-color: #667b97; color: #ffffff; }
button:active { background-color: #235d91; border-color: #68a9f2; }
button:focus { border-color: #68a9f2; }
.icon { display: inline-block; width: 16px; height: 16px; vertical-align: middle; flex-shrink: 0; pointer-events: none; }
.icon-label .icon { margin-right: 6px; }
.icon-button { position: relative; width: 30px; height: 28px; padding: 5px; line-height: 16px; }
button .control-tooltip { display: none; }
#editor-control-tooltip { display: none; position: fixed; top: 0px; left: 0px; z-index: 1000; width: auto; height: auto; min-width: 0px; max-width: 320px; margin: 0px; padding: 6px 8px; border: 1px #48576a; border-radius: 3px; background-color: #191d24; color: #d4dae4; font-size: 11px; font-weight: normal; line-height: 16px; text-align: left; white-space: pre-wrap; word-break: break-word; pointer-events: none; focus: none; }
#editor-control-tooltip-text { display: block; min-width: 0px; pointer-events: none; focus: none; }
#menubar button { background-color: transparent; border-width: 0; padding: 6px 10px; }
#menubar button:hover { background-color: #303640; }
#projectTitle { color: #8f99a9; font-size: 12px; }
.version { color: #5e6878; margin-left: 20px; font-size: 11px; }
.grow { flex-grow: 1; }
#windowControls { height: 32px; display: flex; align-items: stretch; margin-left: 10px; }
#windowControls .window-control { width: 42px; height: 32px; padding: 8px 13px; background-color: transparent; border-width: 0px; border-radius: 0px; }
#windowControls .window-control:hover { background-color: #303640; color: #ffffff; }
#windowControls .window-control.close:hover { background-color: #c43d51; color: #ffffff; }
#toolbar { height: 48px; flex-shrink: 0; display: flex; align-items: center; background-color: #252a32; border-bottom: 1px #111419; padding: 7px 12px; }
.toolbar-region { display: flex; align-items: center; height: 34px; }
.toolbar-category { display: flex; align-items: center; height: 34px; border-left: 1px #424852; padding-left: 9px; margin-left: 5px; }
.toolbar-category.first { border-left-width: 0px; padding-left: 0px; margin-left: 0px; }
.toolbar-tool { position: relative; height: 32px; margin-right: 5px; }
.toolbar-button { position: relative; min-width: 32px; height: 30px; padding: 5px 8px; }
.toolbar-button .icon { width: 16px; height: 16px; }
#toolbar-tool-mcp { min-width: 122px; color: #b9e6ff; background-color: #24465d; border-color: #4a8cb6; font-weight: bold; }
#toolbar-tool-mcp:hover { color: #ffffff; background-color: #315d79; border-color: #7ac4f2; }
.settings-field.mcp-configuration-row { align-items: flex-start; }
.mcp-configuration-row .settings-field-copy { flex-shrink: 0; }
.settings-control.mcp-configuration-path { width: 55%; min-width: 0px; word-break: break-all; font-size: 11px; line-height: 17px; }
.toolbar-button.disabled, .menu-command.disabled { color: #68778b; background-color: #242a33; border-color: #353d49; pointer-events: none; focus: none; }
.dropdown-arrow { margin-left: 6px; color: #91a0b4; font-size: 9px; }
.toolbar-popup { top: 32px; left: 0px; }
.separator { width: 1px; height: 22px; background-color: #424852; margin: 0px 14px 0px 8px; }
.toolbar-note { font-size: 11px; color: #737f91; }
#workspace { display: flex; flex-direction: row; flex-grow: 1; min-width: 0px; min-height: 0px; }
.dock { background-color: #22262e; flex-shrink: 0; }
#leftdock { width: 244px; display: flex; flex-direction: column; border-right: 1px #111419; }
.pane { display: flex; flex-direction: column; background-color: #22262e; }
#hierarchy { height: 272px; flex-shrink: 0; border-bottom: 3px #14171c; }
#project { flex-grow: 1; min-height: 0px; }
.pane-tabs { height: 34px; flex-shrink: 0; display: flex; align-items: center; background-color: #1c2027; border-bottom: 1px #15181d; padding: 0px 10px; font-size: 12px; }
.pane-tabs span { margin-right: 18px; color: #7f8999; }
.pane-tabs .selected { color: #dbe1ea; border-bottom: 2px #619ce0; height: 34px; padding-top: 8px; }
.pane-tabs .small { padding: 0px 6px; font-size: 12px; background-color: transparent; border-width: 0px; }
.pane-tabs .small.icon-button { width: 24px; height: 24px; padding: 4px; }
.pane-content { padding: 10px; overflow: auto; flex-grow: 1; flex-basis: 0px; }
input { display: block; width: 100%; height: 28px; padding: 5px 8px; margin-bottom: 10px; font-family: Segoe UI; font-size: 12px; color: #d6deeb; background-color: #191d24; border: 1px #383f4c; border-radius: 3px; }
input:focus { border-color: #5d94d2; }
.search-field { position: relative; margin-bottom: 10px; }
.search-field .icon { position: absolute; top: 6px; left: 8px; }
.search-field input { padding-left: 30px; margin-bottom: 0px; }
.tree { display: block; width: 100%; text-align: left; padding: 5px 8px; background-color: transparent; border-width: 0px; border-radius: 2px; margin-bottom: 1px; }
.tree:hover { background-color: #353e4c; }
.tree.scene { color: #e1e8f2; background-color: #314154; }
.tree.indent { padding-left: 24px; color: #a9b4c5; }
.section-label { font-size: 10px; color: #6d7b8f; padding: 10px 8px 6px; }
.path { margin-top: 16px; padding: 8px; border-top: 1px #343b46; font-size: 10px; color: #6e7d93; overflow: hidden; white-space: nowrap; }
#center { flex-grow: 1; min-width: 0px; display: flex; flex-direction: column; background-color: #11151a; position: relative; }
#viewportCanvas { flex-grow: 1; min-height: 100px; background-color: #11151a; }
#viewportOverlay { position: absolute; top: 0px; left: 0px; right: 0px; height: 0px; z-index: 20; background-color: transparent; }
.viewport-custom-bar { position: absolute; top: 10px; left: 17px; display: flex; align-items: flex-start; }
.custom-bar-surface { display: flex; align-items: flex-start; }
.custom-bar-group { display: flex; align-items: center; padding: 3px; background-color: #202731; border: 1px #48576a; border-radius: 2px; }
.custom-bar-group-label { display: none; }
.custom-bar-button { width: 30px; height: 28px; margin-right: 2px; padding: 5px; background-color: #2a323e; border-color: #48576a; }
.custom-bar-button:last-child { margin-right: 0px; }
.custom-bar-button .icon { width: 16px; height: 16px; }
.custom-bar-button:hover { background-color: #3a4859; }
.custom-bar-button.checked { background-color: #315f8b; border-color: #6a9ed1; color: #ffffff; }
.timeline-custom-bar { display: flex; flex-grow: 1; align-items: center; }
.timeline-custom-bar .custom-bar-surface { width: 100%; }
.timeline-custom-bar .custom-bar-group { width: 100%; border-width: 0px; padding: 0px; background-color: transparent; }
.timeline-custom-bar .custom-bar-group-label { display: none; }
.timeline-preview-host { display: block; height: 150px; flex-shrink: 0; overflow: hidden; border-bottom: 1px #101318; background-color: #11161d; }
.timeline-preview { display: flex; width: 100%; height: 100%; align-items: stretch; }
.timeline-preview-stage { position: relative; width: 220px; flex-shrink: 0; overflow: hidden; background-color: #0d1218; border-right: 1px #2b3542; }
.timeline-preview-grid { position: absolute; left: 0px; right: 0px; bottom: 28px; height: 1px; background-color: #3b4a5c; }
.timeline-preview-link { position: absolute; height: 2px; transform-origin: 0px 50%; background-color: #5e9bc5; }
.timeline-preview-bone { position: absolute; width: 9px; height: 9px; margin-left: -4px; margin-top: -4px; border: 2px #e5b870; border-radius: 50%; background-color: #8d5d37; }
.timeline-preview-info { display: flex; flex-direction: column; flex-grow: 1; min-width: 0px; padding: 12px 14px; }
.timeline-preview-title { color: #dce6f2; font-size: 12px; }
.timeline-preview-subtitle { margin-top: 4px; color: #8798ad; font-size: 10px; }
.timeline-preview-progress { height: 4px; margin-top: 12px; background-color: #293442; }
.timeline-preview-progress-value { height: 100%; background-color: #50a891; }
.timeline-preview-pose { margin-top: 10px; color: #9eafc3; font-family: monospace; font-size: 10px; white-space: pre; }
.viewport-projection { position: absolute; top: 10px; right: 14px; padding: 4px 9px; color: #d5deeb; background-color: #202731; border-color: #4a586a; font-size: 11px; }
.viewport-footer { display: flex; align-items: center; height: 24px; flex-shrink: 0; padding: 0px 12px; color: #64758b; font-size: 10px; background-color: #151b23; border-top: 1px #252e3b; }
.timeline-pane { display: flex; flex-direction: column; flex-grow: 1; min-width: 0px; min-height: 0px; background-color: #171b22; }
.timeline-documents { display: flex; flex-shrink: 0; min-height: 28px; overflow-x: auto; background-color: #1b2028; border-bottom: 1px #101318; }
.timeline-document-tab { flex-shrink: 0; height: 28px; padding: 4px 12px; margin-right: 1px; border-width: 0px; border-bottom: 2px transparent; background-color: #252c36; color: #9eafc3; }
.timeline-document-tab.active { border-bottom-color: #5c9ad2; background-color: #303b49; color: #e0ecf8; }
.timeline-toolbar { display: flex; align-items: center; height: 38px; flex-shrink: 0; padding: 5px 8px; background-color: #242a32; border-bottom: 1px #101318; }
.timeline-toolbar button { height: 28px; margin-right: 5px; padding: 4px 8px; }
.timeline-toolbar .icon { width: 14px; height: 14px; }
.timeline-toolbar-separator { width: 1px; height: 22px; margin: 0px 8px 0px 3px; background-color: #434c58; }
.timeline-time { padding-right: 5px; color: #bdcce0; font-family: monospace; font-size: 11px; }
.timeline-view-host { position: relative; flex-grow: 1; min-width: 0px; min-height: 0px; overflow: hidden; }
.timeline-empty { padding: 20px; color: #77869a; }
.timeline-notify-inspector { display: flex; align-items: center; min-height: 30px; padding: 0px 10px; border-top: 1px #303744; background-color: #202630; color: #b8c6d7; font-size: 11px; }
.timeline-inspector-label { margin-right: 12px; color: #718198; font-size: 10px; }
#console { height: 152px; flex-shrink: 0; border-top: 3px #12161b; }
.console-line { display: flex; padding: 7px 12px; font-size: 11px; }
.log-time { margin-right: 10px; color: #5a8cb4; }
.muted { color: #748093; }
.good { color: #78b893; }
.logs-pane { display: flex; flex-direction: column; flex-grow: 1; min-width: 0px; min-height: 0px; background-color: #1d222a; }
.logs-header { display: flex; flex-shrink: 0; align-items: center; height: 30px; padding: 0px 10px; border-bottom: 1px #303744; }
.logs-title { color: #d5deeb; font-size: 11px; }
.logs-hint { margin-left: 12px; color: #6e7d91; font-size: 9px; }
.log-entries { flex-grow: 1; min-width: 0px; min-height: 0px; overflow: auto; padding: 2px 0px; }
.log-entry { display: flex; align-items: flex-start; min-width: 0px; padding: 4px 10px; border-bottom: 1px #29313a; font-size: 10px; line-height: 14px; }
.log-entry:hover { background-color: #29323d; }
.log-entry .log-time { width: 78px; flex-shrink: 0; margin-right: 8px; color: #6f89a5; }
.log-level { width: 58px; flex-shrink: 0; margin-right: 8px; color: #8ea1b8; font-size: 9px; }
.log-source { width: 62px; flex-shrink: 0; margin-right: 8px; color: #718399; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.log-category { width: 112px; flex-shrink: 0; margin-right: 8px; color: #9eb8d2; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.log-message { flex-grow: 1; min-width: 0px; color: #cbd4df; white-space: normal; }
.log-exception { display: block; margin-top: 2px; color: #d99aa4; white-space: pre-wrap; }
.log-level-warning .log-level { color: #e2bd79; }
.log-level-error .log-level, .log-level-critical .log-level { color: #e08b96; }
.log-level-debug .log-level, .log-level-trace .log-level { color: #8091a7; }
.logs-empty { padding: 12px 10px; color: #6d7c90; font-size: 10px; }
.log-entries scrollbarvertical { width: 12px; background-color: #191d24; }
.log-entries scrollbarvertical sliderbar { width: 10px; min-height: 16px; margin-left: 1px; background-color: #48576a; border-radius: 3px; }
.log-entries scrollbarvertical sliderbar:hover { background-color: #6a9ed1; }
#inspector { width: 286px; border-left: 1px #111419; display: flex; flex-direction: column; }
#selectedObject { font-size: 16px; color: #e0e6f0; margin: 4px 0px; }
.object-kind { color: #6e7e94; font-size: 11px; margin-bottom: 20px; }
.component { margin-bottom: 16px; border: 1px #363e4a; border-radius: 3px; }
.component-title { padding: 8px 10px; background-color: #2b323d; border-bottom: 1px #363e4a; color: #c7d3e3; font-size: 12px; }
.field { display: flex; padding: 9px 8px; font-size: 11px; border-bottom: 1px #2a303a; }
.field label { width: 72px; color: #7d8da4; }
.field span { flex-grow: 1; color: #adbace; }
#statusbar { height: 24px; flex-shrink: 0; background-color: #1b2532; display: flex; align-items: center; padding: 0px 12px; color: #a6b8ce; font-size: 10px; border-top: 1px #2f3a49; }
.status-dot { width: 5px; height: 5px; background-color: #78bd96; border-radius: 3px; margin-right: 8px; }

.tree-item, .asset-item { display: block; width: 100%; text-align: left; padding: 6px 8px; background-color: transparent; border-width: 0px; border-radius: 2px; margin-bottom: 1px; }
.tree-item:hover, .asset-item:hover { background-color: #353e4c; }
.tree-item.selected, .asset-item.selected { background-color: #314d6a; color: #e9f2ff; }
.tree-item.child { padding-left: 24px; }
.item-icon { margin-right: 8px; }
.asset-item.list-item { display: flex; align-items: center; min-height: 30px; }
.asset-name { flex-grow: 1; min-width: 0px; }
.item-kind { color: #6f829a; font-size: 10px; margin-left: 8px; }
.asset-item .item-kind { flex-shrink: 0; }
.empty-list { color: #67778b; font-size: 11px; padding: 8px; }
.content-manager-pane { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; display: flex; flex-direction: column; min-width: 0px; min-height: 0px; overflow: hidden; border-top: 2px transparent; }
.content-manager-pane.active-content-manager { border-top-color: #68a9f2; }
.dock-tab.active-content-manager-tab { color: #f2f7ff; border-top: 2px #68a9f2; }
.dock-tab.content-manager-tab { border-top: 2px transparent; }
.content-pane-toolbar { padding-top: 8px; }
.content-pane-toolbar .search-field, .content-pane-toolbar .small { margin-bottom: 4px; }
.content-pane-toolbar .search-field { min-width: 80px; }
.content-pane-toolbar .icon-button { flex-shrink: 0; margin-left: 2px; }
.content-pane { display: flex; flex-direction: column; flex-grow: 1; flex-shrink: 1; flex-basis: 0px; min-width: 0px; min-height: 0px; padding: 0px; overflow: hidden; }
.content-controls { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; padding: 0px 10px; }
.content-controls .content-navigation { flex-grow: 1; margin-right: 12px; }
.content-results-slot { position: relative; flex-grow: 1; flex-shrink: 1; flex-basis: 0px; min-width: 0px; min-height: 0px; }
.content-results { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; overflow: auto; padding: 0px 10px 4px; }
/* RmlUi scrollbars require explicit dimensions; auto width consumes the entire result area. */
.content-results scrollbarvertical { width: 12px; background-color: #191d24; }
.content-results scrollbarvertical sliderbar { width: 10px; min-height: 16px; margin-left: 1px; background-color: #48576a; border-radius: 3px; }
.content-results scrollbarhorizontal { height: 12px; background-color: #191d24; }
.content-results scrollbarhorizontal sliderbar { height: 10px; min-width: 16px; margin-top: 1px; background-color: #48576a; border-radius: 3px; }
.content-results sliderbar:hover { background-color: #6a9ed1; }
.content-results sliderarrowdec, .content-results sliderarrowinc { width: 0px; height: 0px; }
.content-toolbar { display: flex; flex-wrap: wrap; margin: 0px 0px 4px; }
.content-toolbar button { margin: 0px 4px 4px 0px; }
.content-toolbar button { padding: 4px 7px; font-size: 10px; height: 28px; }
.content-toolbar .icon { width: 14px; height: 14px; }
.content-toolbar .icon-button { width: 28px; padding: 5px 6px; }
.content-navigation { display: flex; align-items: center; min-height: 25px; margin-bottom: 5px; color: #b9c7d9; font-size: 11px; }
.content-navigation button { width: 24px; height: 24px; padding: 3px; margin-right: 6px; }
.content-navigation > span { min-width: 0px; overflow: hidden; white-space: nowrap; }
.breadcrumb-icon { width: 14px; height: 14px; margin-right: 6px; }
.content-section, .content-items, .content-context { display: block; width: 100%; }
.content-summary { padding: 3px 8px 8px; color: #8ea1b8; font-size: 10px; }
.content-context.tile-view { display: flex; flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.asset-item.tile-item { position: relative; display: flex; flex-direction: column; flex-shrink: 0; align-items: center; justify-content: center; width: 112px; height: 82px; padding: 6px; margin: 0px 6px 6px 0px; text-align: center; border: 1px transparent; }
.asset-item.tile-item .item-icon { width: 32px; height: 32px; margin: 0px 0px 4px; }
.asset-item.tile-item .asset-name { width: 100%; flex-grow: 0; overflow: hidden; white-space: nowrap; }
.asset-item.tile-item .item-kind { width: 100%; margin: 3px 0px 0px; overflow: hidden; white-space: nowrap; }
.asset-item.tile-item.selected { border-color: #619ce0; }
.asset-item.tile-item .readonly-icon { position: absolute; top: 4px; right: 4px; }
.asset-item.list-item .asset-name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.content-path { height: 22px; flex-shrink: 0; margin-top: 0px; padding: 4px 10px; }
.readonly-icon { width: 12px; height: 12px; margin-left: 5px; opacity: 0.7; }
.asset-item.missing { color: #c98b8b; }
viewport { display: block; }
.dock-host { position: relative; display: flex; flex-direction: column; flex-grow: 1; min-width: 0px; min-height: 0px; overflow: hidden; background-color: #11151a; }
.dock-canvas { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; }
.dock-split { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; display: flex; min-width: 0px; min-height: 0px; overflow: hidden; }
.dock-horizontal { flex-direction: row; }
.dock-vertical { flex-direction: column; }
.dock-split-first { position: relative; display: flex; flex-basis: 0px; flex-shrink: 1; min-width: 0px; min-height: 0px; overflow: hidden; }
.dock-split-second { position: relative; display: flex; flex-basis: 0px; flex-shrink: 1; min-width: 0px; min-height: 0px; overflow: hidden; }
.dock-splitter { position: absolute; z-index: 80; background-color: #111419; }
.dock-splitter:hover { background-color: #4d769d; }
.dock-splitter.dock-splitter-dragging { background-color: #70a9df; }
.dock-splitter-horizontal { width: 4px; margin-left: -2px; cursor: resize; }
.dock-splitter-vertical { height: 4px; margin-top: -2px; cursor: resize; }
.dock-group { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; display: flex; flex-direction: column; min-width: 160px; min-height: 120px; overflow: hidden; background-color: #22262e; border: 1px #111419; }
.dock-group.viewport-group { min-width: 320px; min-height: 200px; background-color: #11151a; }
.dock-tabbar { height: 34px; flex-shrink: 0; display: flex; align-items: stretch; overflow: hidden; background-color: #1c2027; border-bottom: 1px #15181d; padding-left: 6px; }
.dock-tab { display: flex; align-items: center; min-width: 0px; max-width: 220px; height: 34px; padding: 0px 8px; margin-right: 2px; color: #7f8999; background-color: transparent; border-width: 0px; border-bottom: 2px transparent; border-radius: 0px; }
.dock-tab:hover { color: #e4ebf5; background-color: #2a313b; }
.dock-tab.active { color: #e4ebf5; background-color: #252b34; border-bottom-color: #619ce0; }
.dock-tab-label { min-width: 0px; overflow: hidden; white-space: nowrap; }
.dock-tab-close { width: 18px; height: 18px; flex-shrink: 0; margin-left: 7px; color: #7e8999; text-align: center; line-height: 17px; border-radius: 2px; }
.dock-tab-close:hover { color: #ffffff; background-color: #a33c4c; }
/* Dock bodies fill their allocation. Auto bases repeatedly measure the nested
   pane contents before laying them out again at the final size during resize. */
.dock-stack { display: flex; flex-direction: column; flex-grow: 1; flex-basis: 0px; min-width: 0px; min-height: 0px; overflow: hidden; }
.dock-pane { position: relative; flex-direction: column; flex-grow: 1; flex-basis: 0px; min-width: 0px; min-height: 0px; overflow: hidden; }
.dock-drop-preview { display: none; position: absolute; z-index: 250; pointer-events: none; }
.dock-drop-preview.split { border: 2px #70a9df; background-color: #315f8b66; }
.dock-drop-preview.merge { border: 2px #8bc5f5; background-color: #315f8b2f; }
.dock-tab-insert-preview { display: none; position: absolute; top: 4px; z-index: 260; width: 2px; height: 26px; background-color: #8bc5f5; pointer-events: none; }
.dock-candidate-guide { display: none; position: absolute; z-index: 245; border: 1px #b4c0ce; background-color: transparent; pointer-events: none; }
.dock-guide-center { position: absolute; left: 25%; top: 25%; width: 50%; height: 50%; border: 1px #b4c0ce; background-color: transparent; }
.dock-candidate-guide.float .dock-guide-center { background-color: #315f8b55; border-color: #8bc5f5; }
.dock-guide-line { position: absolute; z-index: 246; height: 1px; background-color: #b4c0ce; transform-origin: left center; }
.pane-toolbar { display: flex; flex-shrink: 0; align-items: center; padding: 10px 10px 0px; }
.pane-toolbar .search-field { flex-grow: 1; margin-right: 6px; }
.pane-toolbar .small { width: 28px; height: 28px; padding: 4px; margin-bottom: 10px; }
.hierarchy-items { flex-grow: 1; flex-basis: 0px; min-height: 0px; overflow: auto; padding: 0px 10px 10px; }
.hierarchy-row { display: flex; align-items: center; min-width: 0px; }
.tree-toggle { width: 18px; height: 26px; flex-shrink: 0; padding: 0px; color: #8fa1b6; background-color: transparent; border-width: 0px; }
.tree-toggle-spacer { width: 18px; flex-shrink: 0; }
.hierarchy-entity { display: flex; align-items: center; flex-grow: 1; min-width: 0px; }
.hierarchy-draggable { drag: drag-drop; }
.tree-label { flex-grow: 1; min-width: 0px; overflow: hidden; white-space: nowrap; text-align: left; }
.hierarchy-drop-before { border-top: 2px #70a9df; }
.hierarchy-drop-after { border-bottom: 2px #70a9df; }
.hierarchy-drop-inside { background-color: #315f8b; }
.hierarchy-drop-root { border: 2px #70a9df; background-color: #315f8b33; }
.hierarchy-diagnostic { margin: 8px; padding: 8px; color: #efb2b2; border: 1px #8c4650; }
.viewport-pane { position: relative; display: flex; flex-direction: column; flex-grow: 1; flex-basis: 0px; min-width: 0px; min-height: 0px; }
.viewport-pane #viewportCanvas { flex-grow: 1; flex-basis: 0px; min-width: 0px; min-height: 100px; }
.ui-editor-pane { display: flex; flex-direction: column; flex-grow: 1; min-width: 640px; min-height: 360px; background-color: #15191f; }
.ui-document-tabs { display: flex; height: 34px; flex-shrink: 0; align-items: stretch; padding-left: 6px; background-color: #181c22; border-bottom: 1px #303844; overflow: hidden; }
.ui-document-tab { display: flex; align-items: center; min-width: 120px; max-width: 240px; height: 34px; padding: 0px 8px; margin-right: 2px; color: #8995a6; background-color: transparent; border-width: 0px; border-bottom: 2px transparent; border-radius: 0px; }
.ui-document-tab.active { color: #edf3fb; background-color: #252c35; border-bottom-color: #3aa78f; }
.ui-document-tab .icon { margin-right: 6px; }
.ui-document-tab span { overflow: hidden; white-space: nowrap; }
.ui-document-close { width: 18px; flex-shrink: 0; margin-left: 7px; color: #7c8796; text-align: center; }
.ui-document-close:hover { color: #ffffff; background-color: #ad4352; }
.ui-editor-empty-tab { padding: 9px 12px; color: #68778a; font-size: 11px; }
.ui-editor-toolbar { display: flex; align-items: center; height: 42px; flex-shrink: 0; padding: 6px 8px; background-color: #242a32; border-bottom: 1px #101318; }
.ui-editor-toolbar button { height: 28px; margin-right: 5px; padding: 4px 8px; }
.ui-toolbar-separator { width: 1px; height: 22px; margin: 0px 8px 0px 3px; background-color: #434c58; }
.ui-resolution { padding: 4px 8px; color: #9babc0; background-color: #191e25; border: 1px #3d4653; border-radius: 3px; font-size: 10px; }
.ui-editor-workspace { display: flex; flex-direction: row; flex-grow: 1; min-width: 0px; min-height: 0px; }
.ui-editor-hierarchy-panel { display: flex; flex-direction: column; width: 190px; min-width: 150px; flex-shrink: 0; background-color: #20252c; border-right: 1px #101318; }
.ui-editor-inspector-panel { display: flex; flex-direction: column; width: 246px; min-width: 210px; flex-shrink: 0; background-color: #20252c; border-left: 1px #101318; }
.ui-panel-title { height: 29px; flex-shrink: 0; padding: 9px 10px 6px; color: #728298; font-size: 9px; border-bottom: 1px #343c47; }
.ui-element-hierarchy, .ui-element-inspector { flex-grow: 1; min-height: 0px; overflow: auto; padding: 6px; }
.ui-tree-row { display: flex; align-items: center; width: 100%; height: 27px; padding-top: 4px; padding-right: 6px; padding-bottom: 4px; margin-bottom: 1px; color: #aeb9c8; background-color: transparent; border-width: 0px; text-align: left; }
.ui-tree-row:hover { background-color: #303945; }
.ui-tree-row.selected { color: #f1f7ff; background-color: #285348; }
.ui-tree-row.invalid { color: #c58c92; }
.ui-tree-tag { width: 58px; flex-shrink: 0; color: #58b9a2; font-size: 10px; }
.ui-editor-canvas-shell { display: flex; flex-direction: column; flex-grow: 1; min-width: 0px; min-height: 0px; background-color: #101419; }
.ui-canvas-rulers { display: flex; height: 25px; flex-shrink: 0; align-items: center; padding: 0px 10px; color: #66768a; background-color: #171c22; font-size: 9px; }
.ui-editor-canvas-scroll { display: flex; flex-grow: 1; min-width: 0px; min-height: 0px; overflow: auto; padding: 28px; background-color: #0d1116; }
.ui-editor-canvas { position: relative; width: 100%; height: 100%; min-width: 360px; min-height: 203px; flex-shrink: 0; overflow: hidden; background-color: #202833; border: 1px #546171; }
.ui-preview-screen { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; display: flex; flex-direction: column; overflow: hidden; }
.ui-authored-node { min-width: 1px; min-height: 1px; }
.ui-editor-empty-canvas { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; color: #718096; }
.ui-empty-icon { width: 54px; height: 54px; padding: 17px 0px; margin-bottom: 10px; text-align: center; color: #79ccb8; border: 1px #3c7f70; border-radius: 4px; font-weight: bold; }
.ui-editor-diagnostics { height: 25px; flex-shrink: 0; padding: 6px 10px; color: #8090a5; background-color: #171c22; border-top: 1px #29313b; font-size: 9px; overflow: hidden; white-space: nowrap; }
.ui-editor-empty { padding: 12px 8px; color: #6c7b8e; font-size: 11px; }
.ui-inspector-heading { display: flex; align-items: center; padding: 8px; margin-bottom: 8px; color: #e2eaf4; background-color: #29313a; border: 1px #3b4653; }
.ui-inspector-heading .ui-tag { margin-right: 8px; color: #5dc0a8; }
.ui-inspector-section { margin-bottom: 10px; }
.ui-inspector-label { display: block; margin-bottom: 4px; color: #8292a8; font-size: 10px; }
.ui-inspector-section input { height: 27px; margin-bottom: 0px; }
.ui-segmented { display: flex; }
.ui-segmented button { flex-grow: 1; height: 27px; border-radius: 0px; }
.ui-segmented button.active { color: #ffffff; background-color: #28715f; border-color: #52b79f; }
.ui-delete-button { width: 100%; margin-top: 5px; color: #e7a7ad; background-color: #3a252b; border-color: #72434b; }
.settings-window { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; display: flex; min-width: 0px; min-height: 0px; background-color: #171b21; }
.settings-sidebar { width: 190px; flex-shrink: 0; padding: 12px 8px; overflow: auto; background-color: #1c2128; border-right: 1px #343b46; }
.settings-title { padding: 3px 8px 12px; color: #edf2f8; font-size: 15px; }
.settings-category { padding: 12px 8px 5px; color: #73869d; font-size: 9px; text-transform: uppercase; }
.settings-page { display: flex; width: 100%; min-height: 30px; align-items: center; padding: 6px 9px; margin-bottom: 2px; color: #aeb9c8; text-align: left; background-color: transparent; border-width: 0px; border-radius: 3px; }
.settings-page:hover { color: #eef4fb; background-color: #2a333e; }
.settings-page.active { color: #ffffff; background-color: #315675; }
.settings-dirty { margin-left: 6px; color: #f0bd68; }
.settings-content { display: flex; flex-direction: column; flex-grow: 1; min-width: 0px; min-height: 0px; }
.settings-header { display: flex; min-height: 62px; flex-shrink: 0; align-items: center; padding: 10px 14px; background-color: #20262e; border-bottom: 1px #353d48; }
.settings-heading { color: #e9eff7; font-size: 16px; }
.settings-id { margin-top: 3px; color: #71839a; font-size: 9px; }
.settings-action { height: 29px; margin-left: 5px; padding: 5px 10px; }
.settings-action.primary { color: #ffffff; background-color: #28715f; border-color: #52b79f; }
.settings-action.disabled { color: #5c6673; background-color: #252a31; border-color: #343a43; }
.settings-fields { flex-grow: 1; min-height: 0px; overflow: auto; padding: 14px; }
.settings-field { display: flex; min-height: 50px; align-items: center; padding: 8px 10px; border-bottom: 1px #2f3741; }
.settings-field-copy { width: 45%; min-width: 130px; padding-right: 12px; }
.settings-field-copy label { display: block; color: #cbd5e2; font-size: 11px; }
.settings-field-copy span { display: block; margin-top: 3px; color: #77889d; font-size: 9px; }
.settings-control { flex-grow: 1; min-width: 120px; }
.settings-control input { height: 29px; margin-bottom: 0px; }
.settings-toggle, .settings-enum { width: 100%; min-height: 29px; text-align: left; }
.settings-toggle.enabled { color: #d8fff3; background-color: #245f51; border-color: #479b85; }
.settings-group { margin-bottom: 10px; border-left: 2px #3f6d91; }
.settings-group-title { padding: 7px 10px; color: #a9c5dd; background-color: #222b34; font-size: 11px; }
.settings-footer { display: flex; height: 27px; flex-shrink: 0; align-items: center; padding: 0px 14px; color: #72849a; background-color: #1b222a; border-top: 1px #343c47; font-size: 9px; }
.settings-empty { padding: 24px; color: #738398; }
.console-header { display: flex; flex-shrink: 0; justify-content: flex-end; height: 24px; padding: 5px 10px; border-bottom: 1px #303744; }
#dockWindow { width: 100%; height: 100%; display: flex; flex-direction: column; background-color: #171a20; }
.dock-window-titlebar { flex-shrink: 0; }
.floating-dock-host { flex-grow: 1; }
.menu-path { padding: 6px 12px 4px; color: #65758a; font-size: 9px; overflow: hidden; }
/* GL2 has no offscreen layer/filter support; box-shadow produces an untextured white quad. */
.menu-popup { display: none; position: absolute; top: 32px; left: 0px; z-index: 300; width: 236px; padding: 5px; background-color: #22262e; color: #d4dae4; border: 1px #4a5566; border-radius: 4px; }
.menu-popup button { display: block; width: 100%; text-align: left; background-color: transparent; color: #d4dae4; border-width: 0px; padding: 8px 12px; }
.menu-popup button:hover { background-color: #3d526c; }
.menu-command { display: flex; align-items: center; }
.menu-check { display: inline-block; width: 24px; color: #7fc0ff; font-weight: bold; }
.empty-menu { padding: 8px 12px; color: #758195; }
.context-menu { position: absolute; top: 0px; left: 0px; z-index: 500; }
.menu-heading { padding: 6px 12px 4px; color: #718198; font-size: 10px; letter-spacing: 1px; }
.menu-divider { height: 1px; margin: 5px; background-color: #424d5c; }

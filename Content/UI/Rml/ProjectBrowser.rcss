#browser-content { flex: 1 1 0px; min-width: 0px; min-height: 0px; display: flex; flex-direction: column; padding: 28px 32px; overflow: auto; }
.browser-heading { display: flex; align-items: center; flex-shrink: 0; height: 48px; margin-bottom: 18px; }
.browser-title { color: #edf1f7; font-size: 26px; font-weight: bold; margin-right: 18px; }
.browser-subtitle { color: #8f99a9; font-size: 13px; }
.browser-heading button { margin-left: 10px; }
.browser-path { display: flex; flex-shrink: 0; align-items: center; margin-bottom: 20px; }
.browser-path input { flex: 1 1 0px; min-width: 0px; width: auto; margin: 0px 10px 0px 0px; }
.browser-path button, .browser-heading button { flex-shrink: 0; }
.browser-columns { display: flex; flex: 1 1 0px; min-width: 0px; min-height: 120px; overflow: hidden; background-color: #1c2027; border: 1px #303743; }
.browser-projects { width: 29%; min-width: 180px; flex-shrink: 0; padding: 12px; border-right: 1px #303743; overflow: auto; }
.browser-projects .tree { padding: 10px 12px; margin-bottom: 5px; }
.browser-project-version { display: block; color: #8798ad; margin-top: 4px; font-size: 11px; }
.browser-details { flex: 1 1 auto; min-width: 0px; min-height: 0px; padding: 22px 26px; overflow: auto; }
.browser-panel-title { color: #e1e8f2; font-size: 20px; margin: 16px 0px; }
.browser-cover { display: flex; align-items: center; justify-content: center; width: 100%; height: 28vh; min-height: 80px; max-height: 235px; background-color: #11151a; border: 1px #303743; overflow: hidden; }
.browser-cover img { max-width: 100%; max-height: 100%; }
.browser-cover-placeholder { color: #6e7d93; text-align: center; }
.browser-metadata { color: #9eafc3; font-size: 12px; line-height: 24px; word-break: break-all; }
.browser-actions { display: flex; flex-wrap: wrap; flex-shrink: 0; margin-top: 22px; }
.browser-actions button { margin-right: 10px; }
.browser-empty { color: #8798ad; padding: 20px 12px; line-height: 24px; }
.browser-field-label { color: #9eafc3; margin: 15px 0px 8px; }
.browser-status { flex-shrink: 0; height: 30px; padding-top: 12px; color: #91a0b4; font-size: 12px; }
.browser-diagnostic { flex-shrink: 0; padding: 12px; margin-top: 10px; color: #e2a48a; background-color: #30251f; white-space: pre-wrap; word-break: break-all; }
button:disabled { color: #68778b; background-color: #242a33; border-color: #353d49; }
.browser-button.disabled { color: #68778b; background-color: #242a33; border-color: #353d49; pointer-events: none; focus: none; }

/* RmlUi needs explicit scrollbar dimensions to preserve the content width. */
#browser-content scrollbarvertical { width: 12px; background-color: #191d24; }
#browser-content scrollbarvertical sliderbar { width: 10px; min-height: 16px; margin-left: 1px; background-color: #48576a; border-radius: 3px; }
#browser-content scrollbarvertical sliderbar:hover { background-color: #6a9ed1; }
#browser-content scrollbarhorizontal { height: 12px; background-color: #191d24; }
#browser-content scrollbarhorizontal sliderbar { height: 10px; min-width: 16px; margin-top: 1px; background-color: #48576a; border-radius: 3px; }

@media (max-height: 600px)
{
    #browser-content { padding: 12px 16px; }
    .browser-heading { height: 36px; margin-bottom: 8px; }
    .browser-path { margin-bottom: 10px; }
    .browser-details { padding: 12px 16px; }
    .browser-panel-title { margin: 10px 0px; }
    .browser-actions { margin-top: 12px; }
}

@media (max-width: 720px)
{
    #browser-content { padding: 12px; }
    .browser-subtitle { display: none; }
    .browser-columns { flex-direction: column; min-height: 180px; }
    .browser-projects { width: 100%; min-width: 0px; height: 100px; padding: 6px; border-right-width: 0px; border-bottom: 1px #303743; }
    .browser-details { padding: 12px; }
}

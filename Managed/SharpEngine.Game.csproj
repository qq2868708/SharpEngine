<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>SharpEngine.Game</AssemblyName>
    <RootNamespace>SharpEngine.Game</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>..\x64\$(Configuration)\Managed\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AssetRegistry.cs;BuiltinAssetDescriptions.cs;ContentManager.cs;EditorExtensions.cs;EditorRuntimeExtensions.cs;MeshImport.cs;GameRuntime.cs;NativeEngineApi.cs;UiDocument.cs;UiFramework.cs;EngineUi.cs;UiSemantics.cs;WorldDescription.cs;WorldViewportRenderer.cs;McpEndpoint.cs;EngineSettings.cs;Public\**\*.cs" />
    <ProjectReference Include="Public\SharpEngine.Managed.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Content\UI\*.ui.xml"
          Link="Content\UI\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

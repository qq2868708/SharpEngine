<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SharpEngine.Managed</AssemblyName>
    <RootNamespace>SharpEngine</RootNamespace>
    <Version>0.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>..\..\x64\$(Configuration)\Managed\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <!-- Explicit includes keep the public contract separate from the editor
       game's lifecycle and native callback implementation without moving files. -->
  <ItemGroup>
    <Compile Include="..\AssetRegistry.cs" Link="Assets\AssetRegistry.cs" />
    <Compile Include="..\ContentManager.cs" Link="Assets\ContentManager.cs" />
    <Compile Include="..\BuiltinAssetDescriptions.cs" Link="Assets\BuiltinAssetDescriptions.cs" />
    <Compile Include="..\MeshImport.cs" Link="Assets\MeshImport.cs" />
    <Compile Include="..\GameRuntime.cs" Link="Editor\EditorRuntime.cs" />
    <Compile Include="..\EditorRuntimeExtensions.cs" Link="Editor\EditorRuntimeExtensions.cs" />
    <Compile Include="..\EditorExtensions.cs" Link="Editor\EditorExtensions.cs" />
    <Compile Include="..\NativeEngineApi.cs" Link="Editor\NativeEngineApi.cs" />
    <Compile Include="..\UiDocument.cs" Link="Editor\UiDocument.cs" />
    <Compile Include="..\UiFramework.cs" Link="UI\UiFramework.cs" />
    <Compile Include="..\EngineUi.cs" Link="UI\EngineUi.cs" />
    <Compile Include="..\UiSemantics.cs" Link="UI\UiSemantics.cs" />
    <Compile Include="..\WorldDescription.cs" Link="World\WorldDescription.cs" />
    <Compile Include="..\WorldViewportRenderer.cs" Link="World\WorldViewportRenderer.cs" />
    <Compile Include="..\McpEndpoint.cs" Link="Editor\McpEndpoint.cs" />
    <Compile Include="..\EngineSettings.cs" Link="Editor\EngineSettings.cs" />
  </ItemGroup>
</Project>

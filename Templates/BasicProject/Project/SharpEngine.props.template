<Project>
  <!-- Generated project contract. The environment variable takes precedence over
       the relative path, so a released engine can live outside this project. -->
  <PropertyGroup>
    <SharpEngineRoot Condition="'$(SharpEngineRoot)' == '' and '$(SHARPENGINE_ROOT)' != ''">$(SHARPENGINE_ROOT)</SharpEngineRoot>
    <SharpEngineRoot Condition="'$(SharpEngineRoot)' == ''">__ENGINE_ROOT_EXPRESSION__</SharpEngineRoot>
    <SharpEngineManifest>$(SharpEngineRoot)\Engine\engine.json</SharpEngineManifest>
    <SharpEngineManagedRoot>$(SharpEngineRoot)\Managed</SharpEngineManagedRoot>
    <SharpEngineContentRoot>$(SharpEngineRoot)\Content</SharpEngineContentRoot>
    <SharpEngineToolsRoot>$(SharpEngineRoot)\Tools</SharpEngineToolsRoot>
    <SharpEngineManagedApi Condition="'$(SharpEngineManagedApi)' == ''">$(SharpEngineRoot)\x64\$(Configuration)\Managed\SharpEngine.Managed.dll</SharpEngineManagedApi>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SharpEngine.Managed">
      <HintPath>$(SharpEngineManagedApi)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateSharpEngineReference" BeforeTargets="Build">
    <Error Condition="'$(SharpEngineRoot)' == ''" Text="SharpEngineRoot is empty. Set SHARPENGINE_ROOT or keep the generated relative engine path." />
    <Error Condition="!Exists('$(SharpEngineManifest)')" Text="SharpEngine manifest not found at $(SharpEngineManifest). Set SHARPENGINE_ROOT to a SharpEngine distribution root." />
    <Error Condition="!Exists('$(SharpEngineManagedApi)')" Text="SharpEngine managed API not found at $(SharpEngineManagedApi). Build the engine for $(Configuration) or set SharpEngineManagedApi to the installed public DLL." />
  </Target>
</Project>

{
  "$schema": "https://sharpengine.dev/schemas/assets-v2.json",
  "schemaVersion": 2,
  "assets": [
    {
      "id": "ui/main",
      "type": "UiDocument",
      "name": "Main UI",
      "path": "UI/Main.sui",
      "importer": "SharpEngine.UiDocumentJson",
      "tags": ["ui"]
    },
    {
      "id": "ui/main-style",
      "type": "StyleSheet",
      "name": "Main UI Style",
      "path": "UI/Main.rcss",
      "importer": "RmlUi.StyleSheet",
      "tags": ["ui", "style"]
    },
    {
      "id": "input/actions/gameplay.move",
      "type": "InputAction",
      "name": "Move",
      "path": "Input/Actions/Move.inputaction.json",
      "importer": "SharpEngine.InputActionJson",
      "tags": ["input", "gameplay"]
    },
    {
      "id": "input/actions/gameplay.primary",
      "type": "InputAction",
      "name": "Primary",
      "path": "Input/Actions/Primary.inputaction.json",
      "importer": "SharpEngine.InputActionJson",
      "tags": ["input", "gameplay"]
    },
    {
      "id": "input/contexts/gameplay",
      "type": "InputMappingContext",
      "name": "Gameplay",
      "path": "Input/Contexts/Gameplay.inputmapping.json",
      "importer": "SharpEngine.InputMappingContextJson",
      "tags": ["input", "gameplay"]
    }
  ]
}

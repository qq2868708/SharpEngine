{
  "$schema": "https://sharpengine.dev/schemas/assets-v1.json",
  "schemaVersion": 1,
  "assets": [
    {
      "id": "ui/main",
      "type": "RmlDocument",
      "name": "Main UI",
      "path": "Content/UI/Main.rml",
      "importer": "RmlUi.Document",
      "tags": ["ui"]
    },
    {
      "id": "ui/main-style",
      "type": "StyleSheet",
      "name": "Main UI Style",
      "path": "Content/UI/Main.rcss",
      "importer": "RmlUi.StyleSheet",
      "tags": ["ui", "style"]
    }
  ]
}

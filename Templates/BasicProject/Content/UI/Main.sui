{
  "$schema": "https://sharpengine.dev/schemas/ui-document-v1.json",
  "schemaVersion": 1,
  "name": "__DISPLAY_NAME__ Main UI",
  "rml": "<rml data-sharpengine-schema-version=\"1\" data-view-model=\"game.main-screen@1\">\n<head>\n  <title>__DISPLAY_NAME__ Main UI</title>\n  <link type=\"text/rcss\" href=\"Main.rcss\" />\n</head>\n<body>\n  <div id=\"screen\" class=\"screen\">\n    <div id=\"topbar\" class=\"topbar\">\n      <div id=\"brandBlock\" class=\"brand-block\">\n        <span id=\"eyebrow\" class=\"eyebrow\">SHARPENGINE UI</span>\n        <span id=\"title\" class=\"title\" data-bind=\"screen.title\">__DISPLAY_NAME__</span>\n      </div>\n      <div id=\"statusPill\" class=\"status-pill\">\n        <span id=\"statusDot\" class=\"status-dot\" />\n        <span id=\"status\" data-bind=\"screen.status\">CONNECTED</span>\n      </div>\n    </div>\n    <div id=\"content\" class=\"content\">\n      <div id=\"hero\" class=\"hero\">\n        <span id=\"kicker\" class=\"kicker\">SCREEN-SPACE UI</span>\n        <span id=\"headline\" class=\"headline\">Build responsive interfaces with real runtime layout.</span>\n        <span id=\"summary\" class=\"summary\">This UI screen asset stores its RML inline. Flex layout drives the page; absolute positioning remains available for overlays.</span>\n        <div id=\"actions\" class=\"actions\">\n          <button id=\"continueButton\" class=\"primary\" data-command=\"screen.continue\">Continue</button>\n          <button id=\"settingsButton\" class=\"secondary\" data-command=\"screen.settings\">Settings</button>\n        </div>\n      </div>\n      <div id=\"metrics\" class=\"metrics\">\n        <div id=\"metricHealth\" class=\"metric-card\">\n          <span id=\"healthLabel\" class=\"metric-label\">HEALTH</span>\n          <span id=\"healthValue\" class=\"metric-value\" data-bind=\"player.health\">100</span>\n        </div>\n        <div id=\"metricEnergy\" class=\"metric-card accent-card\">\n          <span id=\"energyLabel\" class=\"metric-label\">ENERGY</span>\n          <span id=\"energyValue\" class=\"metric-value\" data-bind=\"player.energy\">72</span>\n        </div>\n      </div>\n    </div>\n    <div id=\"footer\" class=\"footer\">\n      <span id=\"hint\">RML + RCSS</span>\n      <span id=\"resolution\">1280 x 720 reference</span>\n    </div>\n  </div>\n</body>\n</rml>\n"
}

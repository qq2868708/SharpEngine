<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EngineRuntimeApi>$(MSBuildThisFileDirectory)../../Binaries/Win64/$(Configuration)/Editor/SharpEngine.Runtime.dll</EngineRuntimeApi>
    <EngineComponentGenerator>$(MSBuildThisFileDirectory)../../Binaries/Win64/$(Configuration)/Tools/SharpEngine.ComponentGenerator.dll</EngineComponentGenerator>
    <EngineComponentTargets>$(MSBuildThisFileDirectory)../../Build/SharpEngine.Components.targets</EngineComponentTargets>
    <PluginBuildProperties>SharpEngineUnifiedBuild=true;SharpEngineRuntimeApi=$(EngineRuntimeApi);SharpEngineComponentGenerator=$(EngineComponentGenerator);CustomAfterMicrosoftCommonTargets=$(EngineComponentTargets)</PluginBuildProperties>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Source/SharpEngine.Editor/SharpEngine.Editor.csproj" />
    <ProjectReference Include="../../Source/SharpEngine.ComponentGenerator/SharpEngine.ComponentGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../Plugins/CharacterMovement/Source/CharacterMovement.Runtime/CharacterMovement.Runtime.csproj">
      <AdditionalProperties>$(PluginBuildProperties)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SharpEngine.CharacterMovement.Runtime</AssemblyName>
    <RootNamespace>SharpEngine.CharacterMovement</RootNamespace>
    <SharpEngineModuleId>SharpEngine.CharacterMovement.Runtime</SharpEngineModuleId>
    <SharpEngineModuleType>Runtime</SharpEngineModuleType>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SharpEngine.Runtime">
      <HintPath>$(SharpEngineRuntimeApi)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateSharpEngineModule" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(SharpEngineUnifiedBuild)' != 'true'"
           Text="Direct Module builds are unsupported. Build the generated Solution or use SharpEngineProject -Command Build." />
    <Error Condition="'$(SharpEngineRuntimeApi)' == '' or !Exists('$(SharpEngineRuntimeApi)')"
           Text="SharpEngineRuntimeApi must point to a built SharpEngine.Runtime.dll. Use the SharpEngine project build command." />
  </Target>
</Project>

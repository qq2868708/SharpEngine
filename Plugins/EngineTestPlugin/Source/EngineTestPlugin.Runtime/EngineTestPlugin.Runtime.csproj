<Project>
  <PropertyGroup>
    <SharpEngineRole>Runtime</SharpEngineRole>
    <SharpEngineModuleId>SharpEngine.Test.EnginePlugin.Runtime</SharpEngineModuleId>
    <SharpEngineModuleType>Runtime</SharpEngineModuleType>
  </PropertyGroup>
  <Import Project="..\..\..\..\Build\SharpEngine.Build.props" />
  <PropertyGroup>
    <OutDir>$(SharpEngineOutputRoot)</OutDir>
    <IntDir>$(SharpEngineIntermediateRoot)SharpEngine.Test.EnginePlugin.Runtime\</IntDir>
    <OutputPath>$(SharpEngineOutputRoot)</OutputPath>
    <BaseIntermediateOutputPath>$(SharpEngineIntermediateRoot)SharpEngine.Test.EnginePlugin.Runtime\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SharpEngine.Test.EnginePlugin.Runtime</AssemblyName>
    <RootNamespace>SharpEngine.Test.EnginePlugin</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>$(SharpEngineOutputRoot)</OutputPath>
    <BaseIntermediateOutputPath>$(SharpEngineIntermediateRoot)SharpEngine.Test.EnginePlugin.Runtime\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SharpEngine.Runtime">
      <HintPath>$(SharpEngineRuntimeApi)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateSharpEngineModule" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(SharpEngineUnifiedBuild)' != 'true'"
           Text="Direct Plugin Module builds are unsupported. Build the project through SharpEngine.ProjectBuild." />
    <Error Condition="'$(SharpEngineRuntimeApi)' == '' or !Exists('$(SharpEngineRuntimeApi)')"
           Text="SharpEngineRuntimeApi must point to a built SharpEngine.Runtime.dll." />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
